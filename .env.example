# Supabase Configuration
# Get these from: https://app.supabase.com/project/{project}/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (⚠️ DO NOT EXPOSE IN BROWSER)
# Only used in server-side API routes and Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fantazi_land

# Next.js Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth Providers (optional, for Supabase Auth)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# Email Service (optional, for notifications)
# RESEND_API_KEY=...
# SENDGRID_API_KEY=...

# Third-party APIs (optional)
# STRIPE_SECRET_KEY=...
# STRIPE_PUBLISHABLE_KEY=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false

# Logging & Monitoring (optional)
# SENTRY_DSN=...
# DATADOG_API_KEY=...

# Vercel Environment Variables (auto-set in Vercel)
# VERCEL_ENV=production
# VERCEL_URL=fantazi-land.vercel.app
