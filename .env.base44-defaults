# Base44 sandbox placeholders — listed FIRST in docker-compose.base44.yml env_file,
# so real values from /run/base44/app.env always win.
# Local postgres from the compose "db" service.
DATABASE_URL="postgresql://postgres:postgres@db:5432/fantazi_land?schema=public"
DIRECT_URL="postgresql://postgres:postgres@db:5432/fantazi_land?schema=public"

# Dummy Supabase values: auth/storage features stay inert, the app renders.
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="base44-dev-anon-key"
SUPABASE_SERVICE_ROLE_KEY="base44-dev-service-role-key"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Lien vers le dépôt de l'édition open source (vide = lien masqué dans le studio)
NEXT_PUBLIC_OPEN_SOURCE_URL=""
